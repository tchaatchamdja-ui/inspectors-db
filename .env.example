# =============================================================
#  Configuration de l'application — Inspecteurs & Formateurs
#  Copier ce fichier en .env et remplir les valeurs
# =============================================================

# ---------------------------------------------------------------
# BASE DE DONNÉES
# ---------------------------------------------------------------
# Laisser vide pour utiliser SQLite en local (développement)
DATABASE_URL=

# PostgreSQL local (développement avec PostgreSQL) :
# DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/inspectors_db

# PostgreSQL Render (fourni automatiquement en production) :
# DATABASE_URL=postgresql://user:password@host.render.com/inspectors

# ---------------------------------------------------------------
# SÉCURITÉ
# ---------------------------------------------------------------
# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=uemoa-inspectors-secret-change-me

# ---------------------------------------------------------------
# SERVEUR
# ---------------------------------------------------------------
# Port local (Render fournit $PORT automatiquement en production)
PORT=5005

# ---------------------------------------------------------------
# EMAIL (optionnel — pour réinitialisation de mot de passe)
# ---------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
