# Configuration pour le déploiement
# Copier ce fichier en .env et remplir les valeurs

# Base de données PostgreSQL (fourni par Render)
# Laisser vide pour utiliser SQLite en local
DATABASE_URL=

# Clé secrète JWT (générer une clé aléatoire pour la production)
JWT_SECRET=uemoa-inspectors-secret-change-me

# Port du serveur (Render fournit automatiquement cette variable)
PORT=5005
